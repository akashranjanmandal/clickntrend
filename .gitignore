# Dependencies
node_modules/

# Lock files (project choice: not committed)
package-lock.json
yarn.lock
pnpm-lock.yaml

# Environment files & secrets — never commit
.env
.env.*
!.env.example
**/env
*.pem
*.key
*.p12
*.pfx
*.crt
