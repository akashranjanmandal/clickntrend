*.dump
*.backup
*.bak
*.sql.gz
*.sql.zip
*backup*.sql
*dump*.sql
*.sqlite
*.sqlite3
*.db

# Build output & caches
dist/
build/
.vite/
*.tsbuildinfo
coverage/

# Logs
*.log
npm-debug.log*

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
