# Copy to backend/.env and fill in real values. Never commit backend/.env.

NODE_ENV=development
# macOS uses port 5000 for AirPlay Receiver, so use 5001 locally
PORT=5001
CLIENT_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# PostgreSQL
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=gftd_user
DB_PASSWORD=change-me
DB_NAME=gftd
# false for a local Postgres without SSL; true (or unset) in production
DB_SSL=false

# Gmail SMTP (use a Google App Password, not the account password)
EMAIL_USER=you@example.com
EMAIL_PASSWORD=your-app-password

# Cashfree (online payments). sandbox locally, production on the live server
CASHFREE_APP_ID=your-cashfree-app-id
CASHFREE_SECRET_KEY=your-cashfree-secret-key
CASHFREE_ENV=sandbox

# Razorpay — optional, only to refund orders paid before the switch to Cashfree
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Cloudflare R2 (image uploads)
R2_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY_ID=your-access-key-id
R2_SECRET_ACCESS_KEY=your-secret-access-key
R2_BUCKET_NAME=your-bucket
R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev
