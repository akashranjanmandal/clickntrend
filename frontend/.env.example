# Copy to frontend/.env. Never commit frontend/.env.

# Leave empty: the app always calls /api/... (Vite proxy locally, nginx in production)
VITE_API_URL=

# Razorpay public key id (use an rzp_test_ key locally)
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx

# Local dev only: where Vite forwards /api requests (must match backend PORT)
API_PROXY_TARGET=http://localhost:5001
